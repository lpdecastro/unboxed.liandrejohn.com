{
  "name": "unboxed.liandrejohn.com",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "assets:icons": "mkdir -p css/fonts && cp node_modules/bootstrap-icons/font/fonts/* css/fonts/",
    "assets:js": "mkdir -p js && cp node_modules/bootstrap/dist/js/bootstrap.bundle.min.js js/bootstrap.bundle.min.js",
    "assets": "npm run assets:icons && npm run assets:js",
    "sass:build": "sass --load-path=node_modules --quiet-deps --no-source-map --style=compressed src/scss/main.scss css/main.css",
    "sass:watch": "sass --load-path=node_modules --quiet-deps --no-source-map --watch src/scss/main.scss css/main.css",
    "build": "npm run assets && npm run sass:build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1"
  },
  "devDependencies": {
    "sass": "^1.104.0"
  }
}
