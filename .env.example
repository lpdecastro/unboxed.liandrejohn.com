MONGODB_URI=mongodb://localhost:27017/unboxed
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Absolute site URL used for metadata, canonical links, OG/Twitter images, and the sitemap.
# e.g. https://unboxed.example.com — falls back to http://localhost:3000 in local dev.
NEXT_PUBLIC_SITE_URL=
# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to skip loading Google Analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Resend API key, used server-side only (inside createBooking) to send the admin
# booking notification email via Resend's Node SDK. Never exposed to the browser.
# Leave empty to skip sending the booking notification email.
RESEND_API_KEY=
# HubSpot booking sync (practice CRM integration, see context/features/hubspot-booking-sync-spec.md).
# Server-side only (inside createBooking). Leaving any of the three below empty skips the sync entirely.
#
# One-time manual setup in the HubSpot portal before these will work:
# 1. HUBSPOT_ACCESS_TOKEN — Settings gear -> Integrations -> Private Apps (aka
#    "Legacy Apps") -> Create a private app -> on the Scopes tab check
#    crm.objects.contacts.read/write and crm.objects.deals.read/write -> Create app
#    -> copy the access token shown once.
# 2. HUBSPOT_PIPELINE_ID / HUBSPOT_DEALSTAGE_ID — pick or repurpose a deal
#    pipeline/stage (free plan: rename the existing default pipeline + one of its
#    non-closed stages instead of creating a new one), then fetch their IDs via:
#    curl https://api.hubapi.com/crm/v3/pipelines/deals -H "Authorization: Bearer YOUR_TOKEN"
# 3. Custom Deal property — Settings gear -> Objects -> Deals -> Properties ->
#    Create property -> label "Booking Details" (internal name must be
#    booking_details) -> field type Multi-line text -> Create.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEALSTAGE_ID=
