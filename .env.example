MONGODB_URI=mongodb://localhost:27017/unboxed
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Absolute site URL used for metadata, canonical links, OG/Twitter images, and the sitemap.
# e.g. https://unboxed.example.com — falls back to http://localhost:3000 in local dev.
NEXT_PUBLIC_SITE_URL=
# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to skip loading Google Analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Web3Forms access key (from a Web3Forms account registered with liandrejohn88@gmail.com,
# which determines the delivery inbox). NEXT_PUBLIC_ because Web3Forms' free plan rejects
# server-to-server calls — the booking notification is sent from the browser, and Web3Forms'
# own domain/Origin allowlist + Cloudflare bot protection guard the key from abuse, not secrecy.
# Leave empty to skip sending the booking notification email.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
